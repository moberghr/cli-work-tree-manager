{
  "name": "@moberg_hr/work-tree",
  "version": "2.0.0",
  "description": "Cross-platform Git worktree manager for multiple repositories",
  "type": "module",
  "bin": {
    "work": "./dist/bin.js",
    "wd": "./dist/wd-bin.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.mjs",
    ".claude-plugin",
    "plugins",
    "npm-shrinkwrap.json"
  ],
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsup",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/web/tsconfig.json && tsc -p tests/tsconfig.json",
    "lint": "eslint src tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "tsx src/bin.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "demo": "npm run build && node dist/bin.js web --demo",
    "prepublishOnly": "npm run build",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "keywords": [
    "git",
    "worktree",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moberghr/cli-work-tree-manager.git"
  },
  "homepage": "https://github.com/moberghr/cli-work-tree-manager#readme",
  "bugs": {
    "url": "https://github.com/moberghr/cli-work-tree-manager/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@inquirer/prompts": "^8.7.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^6.0.1",
    "chokidar": "^5.0.0",
    "cross-spawn": "^7.0.6",
    "glob": "^13.0.6",
    "hono": "^4.12.23",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "ws": "^8.22.0",
    "yargs": "^18.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yargs": "^17.0.33",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.7",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "highlight.js": "^11.12.0",
    "highlightjs-cshtml-razor": "^2.2.0",
    "jsdom": "^29.1.1",
    "marked": "^18.0.14",
    "prettier": "3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.3.6",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
